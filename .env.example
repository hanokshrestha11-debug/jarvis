# Add keys only for cloud providers you plan to use.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Install Ollama and pull the selected model (for example: ollama pull llama3.2).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Optional spoken replies using your ElevenLabs voice; otherwise Levi uses the system voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=pcm_24000

# Local Whisper speech recognition. The model downloads on first run.
WHISPER_MODEL=base
LEVI_VOICE_THRESHOLD=0.006
